# Production build: compile the SPA to static files, then serve them with
# nginx instead of the Vite dev server. The dev server (frontend/Dockerfile)
# is unoptimized and explicitly not meant to be reached from the internet -
# see docs/public-exposure-guide.md.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
