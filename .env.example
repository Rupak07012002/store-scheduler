# Copy this file to .env and adjust before running `docker compose up`.
# See docs/setup-runbook.md for a full walkthrough.

# --- Postgres ---
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=scheduler
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://scheduler:change_me_locally@postgres:5432/scheduler
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_PORT=8000

# All 8 stores share this single timezone (confirmed business scope).
BUSINESS_TIMEZONE=America/Chicago

# --- Scheduling defaults (per-store overrides live in the database) ---
DEFAULT_FOOTFALL_TO_STAFF_RATIO=25.0
DEFAULT_MIN_STAFF_FLOOR=1
DEFAULT_AVG_TRANSACTION_VALUE=35.0

# --- Labor rule defaults ---
DEFAULT_MAX_HOURS_BEFORE_OVERTIME=40.0
DEFAULT_OVERTIME_MULTIPLIER=1.5
DEFAULT_MIN_REST_HOURS_BETWEEN_SHIFTS=10.0
DEFAULT_REQUIRED_BREAK_MINUTES=30
DEFAULT_MAX_CONSECUTIVE_DAYS=6

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
